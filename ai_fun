#ai功能实现层

from langchain_deepseek.chat_models import ChatDeepSeek
from langchain_ollama.chat_models import ChatOllama
from langchain_core.prompts import ChatPromptTemplate,MessagesPlaceholder

def ai_fun(chat_history,human_question):
    chat_ol = ChatOllama(model="deepseek-r1:7b")
    chat_ds = ChatDeepSeek(model="deepseek-v4-pro")

    first_prompt = ChatPromptTemplate.format_messages([
        ("system","你是语言揣测的专家和提示词工程师,你需要接受用户传来的语句,在不改变意思的前提下,输出更为优质的提示词"),
        MessagesPlaceholder("chat_history"),
        ("human","{human_question}")
    ])

    finally_prompt = ChatPromptTemplate.format_messages([
        ("system","你是一位了解全行业的岗位信息的专家,专门帮助用户分析和回答求职信息,每次回答都有理有据,绝不胡编乱造,没有根据的问题需回答不清楚"),
        MessagesPlaceholder("chat_history"),
        ("human","{ai_question}")
    ])

    chain = first_prompt | chat_ds | finally_prompt | chat_ol
# ============================================================
# AI 求职检索与回复助手 — 环境配置
# ============================================================
# 将此文件复制为 .env 并填入你的配置值。
# 警告：.env 包含密钥 — 切勿提交到 Git。

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE="你的数据库名称"
DEEPSEEK_API_KEY=your_deepseek_api_key